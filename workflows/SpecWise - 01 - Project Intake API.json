    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map(item => {\n  const body = item.json.body;\n\n  const errors = [];\n\n  if (!body || typeof body !== 'object' || Array.isArray(body)) {\n    errors.push('Request body must be a JSON object.');\n  }\n\n  const title = typeof body?.title === 'string'\n    ? body.title.trim()\n    : '';\n\n  const initialIdea = typeof body?.initial_idea === 'string'\n    ? body.initial_idea.trim()\n    : '';\n\n  if (!title) {\n    errors.push('Project title is required and must be a string.');\n  } else if (title.length > 255) {\n    errors.push('Project title cannot exceed 255 characters.');\n  }\n\n  if (!initialIdea) {\n    errors.push('Initial idea is required and must be a string.');\n  } else if (initialIdea.length > 10000) {\n    errors.push('Initial idea cannot exceed 10000 characters.');\n  }\n\n  return {\n    json: {\n      valid: errors.length === 0,\n      errors,\n      title,\n      initial_idea: initialIdea\n    }\n  };\n});\n"
      },
