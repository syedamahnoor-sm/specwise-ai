      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\n\nconst projectId = body.project_id;\nconst questionId = body.question_id;\nconst answer = body.answer;\n\nconst errors = [];\n\nconst uuidRegex =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nif (typeof projectId !== 'string' || !uuidRegex.test(projectId)) {\n  errors.push('Valid project_id is required.');\n}\n\nif (typeof questionId !== 'string' || !uuidRegex.test(questionId)) {\n  errors.push('Valid question_id is required.');\n}\n\nif (typeof answer !== 'string' || !answer.trim()) {\n  errors.push('Answer cannot be empty.');\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    project_id: projectId,\n    question_id: questionId,\n    answer: typeof answer === 'string' ? answer.trim() : ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
