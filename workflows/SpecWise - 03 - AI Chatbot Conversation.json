        "query": "SELECT\n    id,\n    project_id,\n    question,\n    category,\n    priority,\n    status\nFROM clarification_questions\nWHERE project_id = $1::uuid\n  AND status = 'pending'\nORDER BY\n    CASE priority\n        WHEN 'high' THEN 1\n        WHEN 'medium' THEN 2\n        WHEN 'low' THEN 3\n        ELSE 4\n    END,\n    id\nLIMIT 1;",
